#!/usr/bin/env python3
"""
validate-db [--full]

Read-only health + consistency checks for the corpus database.

Checks (exit 0 = healthy, 1 = problems found):
  * SQLite integrity_check == ok
  * no foreign-key violations
  * per-build shape invariant: runs == tasks * engines
  * run_counter uniformity, checked per (build, machine, header version)
    against v_header_expectations rather than hardcoded counts -- the
    expected number depends on hardware (v4_burrata exposes 10 counters,
    v4_manchego 13, v4 14) as well as on the run.cpp revision
  * engines measured per cell, so a 'b' run with no h/v counterpart, or a
    cell missing one engine entirely, is reported
  * latest ingest batches (freshness / header-version)

--full additionally prints all table counts.
"""
import argparse
import sys

import _common  # noqa: F401
from corpus.db import read_only


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--full", action="store_true",
                    help="also print all table counts")
    a = ap.parse_args()

    problems = []

    with read_only() as conn:
        print("== integrity ==")
        row = conn.execute("PRAGMA integrity_check").fetchone()
        res = row[0] if row else "<empty>"
        print(f"  integrity_check: {res}")
        if res != "ok":
            problems.append(f"integrity_check != ok ({res!r})")

        print("== foreign keys ==")
        fk = conn.execute("PRAGMA foreign_key_check").fetchall()
        print(f"  foreign_key_check violations: {len(fk)}")
        for r in fk[:10]:
            print("   ", r)
        if fk:
            problems.append(f"{len(fk)} foreign-key violations")

        print("== shape, per build and node ==")
        shapes = conn.execute("""
            SELECT be.build_event_id, bs.config_name, m.stable_key AS node,
                   COUNT(DISTINCT r.run_id)       AS runs,
                   COUNT(DISTINCT t.task_id)      AS tasks,
                   COUNT(DISTINCT t.query_id)     AS queries,
                   COUNT(DISTINCT t.threads)      AS threads,
                   COUNT(DISTINCT r.engine_id)    AS engines,
                   COUNT(DISTINCT r.snapshot_id)  AS snapshots
            FROM run r
            JOIN build_event be      ON be.build_event_id = r.build_event_id
            JOIN build_spec bs       ON bs.spec_id = be.spec_id
            JOIN task t              ON t.task_id = r.task_id
            JOIN machine_snapshot ms ON ms.snapshot_id = r.snapshot_id
            JOIN machine m           ON m.machine_id = ms.machine_id
            GROUP BY be.build_event_id, bs.config_name, m.stable_key
            ORDER BY be.build_event_id, m.stable_key
        """).fetchall()
        if not shapes:
            print("  (no builds with runs)")
        for be, cfg, node, runs, tasks, queries, threads, engines, snaps in shapes:
            print(f"  be{be:<3} {cfg:<16} {node:<10} runs={runs:<5} tasks={tasks:<3} "
                  f"queries={queries} threads={threads} engines={engines}")
            if queries == 0:
                problems.append(f"build be{be} on {node}: no queries")

        # runs == tasks * engines is NOT a valid invariant. Engine count varies
        # by query -- q6 emits v/h/b while everything else emits v/h -- so the
        # expected total is the sum over cells of that cell's engine count, not
        # a product. Compare against what each query actually uses on that node.
        for be, node, q, got, want in conn.execute("""
            WITH per_query AS (
                SELECT r.build_event_id AS be, ms.machine_id, t.query_id,
                       COUNT(DISTINCT r.engine_id) AS engines,
                       COUNT(DISTINCT t.task_id)   AS tasks,
                       COUNT(*)                    AS runs
                FROM run r
                JOIN task t              ON t.task_id = r.task_id
                JOIN machine_snapshot ms ON ms.snapshot_id = r.snapshot_id
                WHERE r.quality = 'clean'
                GROUP BY r.build_event_id, ms.machine_id, t.query_id
            )
            SELECT pq.be, m.stable_key, q.label, pq.runs, pq.tasks * pq.engines
            FROM per_query pq
            JOIN machine m ON m.machine_id = pq.machine_id
            JOIN query q   ON q.query_id = pq.query_id
            WHERE pq.runs != pq.tasks * pq.engines
        """):
            problems.append(
                f"build be{be} on {node}, {q}: runs={got} != "
                f"tasks*engines={want} -- a cell is missing an engine")

        print("== run_counter consistency (build x node x header) ==")
        # Expected counter count comes from the vocabulary, not a constant:
        # it varies by run.cpp revision AND by hardware, because the profiler
        # only emits a column when the node's PMU exposes the event.
        expected = {r[0]: r[1] for r in conn.execute(
            "SELECT header_version, counter_cols FROM v_header_expectations")}
        for be, node, hv, cnt, n in conn.execute("""
            SELECT r.build_event_id, m.stable_key, ib.header_version,
                   c.cnt AS counters, COUNT(*) AS n_runs
            FROM (SELECT run_id, COUNT(*) AS cnt FROM run_counter GROUP BY run_id) c
            JOIN run r               ON r.run_id = c.run_id
            JOIN ingest_batch ib     ON ib.batch_id = r.batch_id
            JOIN machine_snapshot ms ON ms.snapshot_id = r.snapshot_id
            JOIN machine m           ON m.machine_id = ms.machine_id
            GROUP BY r.build_event_id, m.stable_key, ib.header_version, c.cnt
            ORDER BY r.build_event_id, m.stable_key, c.cnt
        """):
            want = expected.get(hv)
            mark = "" if want is None or cnt == want else f"  != {want} expected"
            print(f"  be{be} {node:10s} {hv:12s} {cnt:3d} counters x {n:4d} runs{mark}")
            if want is not None and cnt != want:
                problems.append(
                    f"build be{be} on {node} under {hv}: {n} run(s) have {cnt} "
                    f"counters, vocabulary says {want}")

        print("== engines per cell ==")
        # A cell measured for only some engines is worth nothing for comparison.
        # With 'b' (q6 branching) this is easy to hit: baseline runs emit v/h/b
        # for q6 but only v/h elsewhere, so 2 is correct outside q6 and 3 inside.
        for q, node, k, n in conn.execute("""
            SELECT qq.label, m.stable_key, x.k, COUNT(*)
            FROM (SELECT task_id, build_event_id, snapshot_id, trial,
                         COUNT(DISTINCT engine_id) AS k
                  FROM run WHERE quality = 'clean'
                  GROUP BY task_id, build_event_id, snapshot_id, trial) x
            JOIN task t              ON t.task_id = x.task_id
            JOIN query qq            ON qq.query_id = t.query_id
            JOIN machine_snapshot ms ON ms.snapshot_id = x.snapshot_id
            JOIN machine m           ON m.machine_id = ms.machine_id
            GROUP BY qq.label, m.stable_key, x.k
            ORDER BY qq.q_number, m.stable_key
        """):
            print(f"  {q:5s} {node:10s} {k} engine(s) x {n:4d} cells")
            if k < 2:
                problems.append(
                    f"{q} on {node}: {n} cell(s) with only {k} engine "
                    f"-- nothing to compare against")

        if a.full:
            print("== table counts ==")
            for (name,) in conn.execute(
                "SELECT name FROM sqlite_master WHERE type='table' "
                "AND name NOT LIKE 'sqlite_%' ORDER BY name"):
                c = conn.execute(f'SELECT COUNT(*) FROM "{name}"').fetchone()[0]
                print(f"  {name:20s} {c:8d}")

        print("== latest ingest batches ==")
        for row in conn.execute(
            "SELECT batch_id, header_version, timing_unit, ingested_at, "
            "substr(out_file, -34) FROM ingest_batch "
            "ORDER BY batch_id DESC LIMIT 5"):
            print("  batch %-3d hv=%-3s tu=%-4s %s  %s" % tuple(row))

    print()
    if problems:
        print("PROBLEMS FOUND:")
        for p in problems:
            print("  -", p)
        return 1
    print("OK: no problems found")
    return 0


if __name__ == "__main__":
    sys.exit(main())
