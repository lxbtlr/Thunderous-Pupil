#!/usr/bin/env python3
"""
backup snapshot   [--to DIR] [--keep N]   full copy, rotated
backup provenance [--out PATH]            SQL text dump of the irreplaceable tables

The corpus is two things in one file.

FACT tables (run, run_counter, ingest_batch) are a CACHE. They rebuild by
re-running ingest-tpch over the .out files, which are the real ground truth.
Losing them costs an afternoon.

DIMENSION tables are NOT reconstructible. A machine_snapshot is a point-in-time
capture; a build_event points at build/tmp.XXXXXXXX, which is ephemeral by
design, so once that directory is cleaned the binary hash and ldd output are
gone for good. A dataset manifest is unrecoverable if the data is regenerated.
Those go in git; the full copy does not.

A plain copy is safe with no quiescing: writes publish by atomic rename with
the WAL already checkpointed, so the canonical file is never half-written.
"""
import argparse, gzip, shutil, subprocess, sys, time
from pathlib import Path
import _common  # noqa: F401
from corpus.db import db_path, read_only, utcnow

# Everything a re-ingest cannot regenerate, plus the vocabulary that gives
# the fact tables meaning.
PROVENANCE_TABLES = [
    "schema_migrations",
    "machine", "machine_snapshot", "spec_capture", "spec_fact",
    "build_spec", "binary", "build_event",
    "dataset", "query", "engine",
    "pmu_event", "csv_column",
]


def sql_literal(v):
    if v is None:
        return "NULL"
    if isinstance(v, bytes):
        return "X'" + v.hex().upper() + "'"
    if isinstance(v, (int, float)):
        return repr(v)
    return "'" + str(v).replace("'", "''") + "'"


def cmd_provenance(args):
    out = Path(args.out)
    lines = [
        f"-- corpus provenance dump, {utcnow()}",
        "-- Dimension tables only. Fact tables are a cache; rebuild them with",
        "-- ingest-tpch over the .out files rather than restoring them here.",
        "PRAGMA foreign_keys = OFF;",
        "BEGIN;",
    ]
    with read_only() as conn:
        present = {r[0] for r in conn.execute(
            "SELECT name FROM sqlite_master WHERE type='table'")}
        for t in PROVENANCE_TABLES:
            if t not in present:
                continue
            rows = conn.execute(f"SELECT * FROM {t}").fetchall()
            lines.append(f"\n-- {t}: {len(rows)} row(s)")
            if not rows:
                continue
            cols = ", ".join(rows[0].keys())
            for r in rows:
                vals = ", ".join(sql_literal(r[k]) for k in r.keys())
                lines.append(f"INSERT INTO {t} ({cols}) VALUES ({vals});")
    lines.append("\nCOMMIT;")
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text("\n".join(lines) + "\n")
    print(f"{out}  ({out.stat().st_size:,} bytes)")
    print("Commit this. It is the part no re-ingest can rebuild.")


def cmd_snapshot(args):
    src = db_path()
    if not src.exists():
        sys.exit(f"no database at {src}")
    dest_dir = Path(args.to)
    dest_dir.mkdir(parents=True, exist_ok=True)
    stamp = time.strftime("%Y%m%dT%H%M%S", time.gmtime())
    dest = dest_dir / f"{src.stem}_{stamp}.sqlite.gz"

    # Safe without quiescing: publish is an atomic rename over a checkpointed
    # file, so the canonical database is never observed half-written.
    with open(src, "rb") as fi, gzip.open(dest, "wb", compresslevel=6) as fo:
        shutil.copyfileobj(fi, fo, length=1 << 22)
    print(f"{dest}  ({dest.stat().st_size:,} bytes from {src.stat().st_size:,})")

    existing = sorted(dest_dir.glob(f"{src.stem}_*.sqlite.gz"))
    for old in existing[:-args.keep]:
        old.unlink()
        print(f"rotated out {old.name}")


ap = argparse.ArgumentParser(description=__doc__,
                             formatter_class=argparse.RawDescriptionHelpFormatter)
sub = ap.add_subparsers(dest="cmd", required=True)

s = sub.add_parser("snapshot", help="gzipped full copy, rotated")
s.add_argument("--to", default="/tank/alexb/vldb-db/backups")
s.add_argument("--keep", type=int, default=14)
s.set_defaults(fn=cmd_snapshot)

p = sub.add_parser("provenance", help="SQL text dump of dimension tables, for git")
p.add_argument("--out", default="/tank/alexb/vldb-db/repo/provenance.sql")
p.set_defaults(fn=cmd_provenance)

a = ap.parse_args()
a.fn(a)
